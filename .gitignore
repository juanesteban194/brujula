# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# testing / e2e
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local env files (keep .env.example tracked)
.env
.env*.local

# vercel
.vercel

# serwist (service worker generated at build time)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# typescript build artifacts
*.tsbuildinfo
next-env.d.ts

# runtime-generated community reports (seed is committed, runtime copy is not)
/data/community_reports.json
