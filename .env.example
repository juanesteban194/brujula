# Brújula — variables de entorno (sin secrets reales)

# ── Frontend (públicas, embebidas en el bundle) ──────────────────────────────
# Base del API. Vacío = mismo origen (recomendado, el API vive dentro de Next).
# Solo cambiar si apuntás a un backend remoto.
NEXT_PUBLIC_API_URL=
# Key opcional de MapTiler para los tiles del mapa (hay fallback OpenFreeMap).
NEXT_PUBLIC_MAPTILER_KEY=

# ── Backend (server-side, NO se exponen al cliente) ──────────────────────────
# Token de administrador para /api/admin/*. Generá uno largo y aleatorio en prod.
ADMIN_TOKEN=brujula-admin-2025
# Rutas a los datos (por defecto usan ./data del proyecto).
CSV_PATH=
REPORTS_PATH=
# Peso global del overlay de riesgo por reportes comunitarios.
RISK_OVERLAY_WEIGHT=0.3
